# @description An interactive psql on this connection
# @toolbar end <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="4 17 10 11 4 5"/><line x1="12" y1="19" x2="20" y2="19"/></svg> psql
# @env PGPASSWORD={password}
psql --host={host} --port={port} --username={user} --dbname={db} --no-password
